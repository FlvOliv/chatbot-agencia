# =============================================================================
# Malu Bot — Lu Milhas & Viagens
# Copie este arquivo para `.env` e preencha com seus secrets reais.
# NUNCA commite o `.env`.
# =============================================================================

# --- Meta WhatsApp Cloud API ---
# Token permanente da Meta Cloud API (Developer Console → System User Token)
WA_TOKEN=your_permanent_access_token
# ID do número de telefone (Developer Console → WhatsApp → API Setup)
WA_PHONE_ID=your_phone_number_id
# String aleatória — usada no handshake de verificação do webhook
WA_VERIFY_TOKEN=qualquer_string_aleatoria
# App secret do app Meta — usado para validar HMAC-SHA256 das requisições
WA_APP_SECRET=seu_app_secret_meta

# --- Google Gemini (provider primário) ---
# Chave gratuita: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (stand-by — pra ativar: AI_PRIMARY=groq) ---
# Chave gratuita: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Transcrição de áudio (Whisper da Groq — MESMA chave acima) ---
# false (padrão) = áudio segue o handoff (acolhe + passa pra Lu).
# true = a Malu transcreve e continua a conversa (confirma de leve o que entendeu).
AUDIO_TRANSCRIPTION_ENABLED=false
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Cerebras (perna GRÁTIS extra — NÃO ativar billing/PAYG) ---
# Chave gratuita: https://cloud.cerebras.ai  ·  vazio = perna desligada
# Confira os modelos da SUA conta em GET /v1/models (varia por conta/tier).
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- Mistral = PISO PAGO (última rede antes do Gemini) ---
# Chave: https://console.mistral.ai  ·  vazio = piso pago desligado
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
PAID_FLOOR_PROVIDER=mistral
PAID_FLOOR_MODEL=open-mistral-nemo
PAID_FLOOR_ENABLED=true
# Teto de tokens pagos por mês (atingido = pula o Mistral). <=0 = sem teto.
MONTHLY_PAID_TOKEN_CAP=30000000

# --- Banco e cache ---
DATABASE_URL=postgresql+asyncpg://malu:malu@localhost:5433/malu
REDIS_URL=redis://localhost:6379/0

# --- Supabase Storage (áudios dos clientes pra Lu ouvir no painel) ---
# Bucket PRIVADO. Sem URL/chave, o upload é pulado (transcrição segue funcionando).
# A service_role key está em Supabase → Settings → API (NUNCA expor no front).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_AUDIO_BUCKET=audios
AUDIO_URL_TTL=3600

# --- Negócio ---
# Telefone da Luciana (atendente humana) no formato E.164 sem '+'
LUCIANA_PHONE=5511999999999
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18

# --- IA ---
# "gemini" | "groq" | "claude" | "openai" | "gemma"
AI_PRIMARY=gemini
# "gemma" | "none"
AI_FALLBACK=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=86400

# --- CRM API (consumida pelo frontend Next.js) ---
# String secreta — usada como header X-API-Key nas rotas /api/*
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRM_API_KEY=
# Origens permitidas no CORS (separadas por vírgula)
CRM_CORS_ORIGINS=http://localhost:3000

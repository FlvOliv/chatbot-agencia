# URL base da API FastAPI (sem /api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Chave usada em X-API-Key — SERVER ONLY, nunca expor no client.
# Deve bater com a mesma chave configurada no backend.
CRM_API_KEY=cole-aqui-a-mesma-key-do-backend

# --- Login do painel (2 usuários: flavio + lu) ---
# AUTH_SECRET: string longa e aleatória que assina a sessão (≥32 caracteres).
# FLAVIO_PASSWORD / LU_PASSWORD: senhas de login. REGRA: mín. 8 caracteres,
# com pelo menos 1 maiúscula, 1 número e 1 caractere especial (ex.: Malu#2026!).
AUTH_SECRET=troque-por-uma-string-longa-e-aleatoria
FLAVIO_PASSWORD=
LU_PASSWORD=

# Configs visuais (lidas em /configuracoes — sem secrets)
NEXT_PUBLIC_LUCIANA_PHONE=5511999999999
NEXT_PUBLIC_AI_PRIMARY=gemini
NEXT_PUBLIC_AI_FALLBACK=groq
NEXT_PUBLIC_BUSINESS_HOURS_START=9
NEXT_PUBLIC_BUSINESS_HOURS_END=18
